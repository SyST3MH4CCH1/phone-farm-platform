# --- Autenticación del panel (obligatorias SIEMPRE) ---
# El servidor NO arranca sin estas variables. No existen credenciales de
# demostración: el bootstrap (setup-new-machine.ps1 / create-admin) genera
# valores fuertes (>=16 chars). Los passwords se almacenan como hash scrypt
# en SQLite (no en .env) tras el primer arranque.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
OPERATOR_USERNAME="operator"
OPERATOR_PASSWORD=""

# --- Token interno Express <-> Flask (OBLIGATORIO) ---
# Debe coincidir EXACTAMENTE con INTERNAL_TOKEN del archivo platform/.env
# Genera uno fuerte:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PHONE_FARM_INTERNAL_TOKEN=""

# --- Backend Flask (proxy) ---
# URL del backend real. Por defecto loopback.
FLASK_BASE="http://127.0.0.1:5000"

# --- MoneyPrinterTurbo ---
# PEXELS_API_KEY: key de Pexels para videoclips de stock.
PEXELS_API_KEY=""
# LLM para guiones (minimax por defecto; también openai/kimi)
LLM_PROVIDER="minimax"
MINIMAX_API_KEY=""

# --- Exposición del código fuente (diagnóstico; NUNCA en producción) ---
# "true" habilita GET /api/source* (solo admin). Por defecto desactivado.
EXPOSE_SOURCE="false"

# --- Servidor ---
# Puerto HTTP (por defecto 3000)
PORT=3000
# NODE_ENV=production fuerza la obligatoriedad de las credenciales.
# NODE_ENV="development"
