# --- Autenticación (obligatorias en producción) ---
# En producción el servidor NO arranca sin estas variables.
# En desarrollo usa los valores de ejemplo siguientes.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
OPERATOR_USERNAME="operator"
OPERATOR_PASSWORD="operator123"

# --- Gemini AI (guiones generados por IA) ---
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- MoneyPrinterTurbo ---
# PEXELS_API_KEY: key de Pexels para videoclips de stock (opcional; sin ella
# el pipeline usa el modo mock/sandboxed).
PEXELS_API_KEY=""

# --- Servidor ---
# Puerto HTTP (por defecto 3000)
PORT=3000
