{
  "name": "phone-farm-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Phone Farm Control Center — panel de control para granjas de teléfonos Android (ADB), proxies y generación de contenido con IA.",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:py": "platform\\.venv\\Scripts\\python.exe -m pytest platform/tests -q",
    "e2e": "npm run build && playwright test",
    "e2e:desktop": "npm run build && playwright test --project=desktop-1440x900",
    "e2e:visual": "npm run build && playwright test e2e/visual.spec.ts",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^6.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "^3.3.17",
    "fast-uri": "^3.1.8",
    "ip-address": "^10.7.3",
    "qs": "^6.16.0"
  }
}
