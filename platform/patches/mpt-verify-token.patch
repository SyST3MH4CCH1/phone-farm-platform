diff --git a/app/asgi.py b/app/asgi.py
index 5ff21fa..45bf8ae 100644
--- a/app/asgi.py
+++ b/app/asgi.py
@@ -70,6 +70,21 @@ def get_application() -> FastAPI:
 
 app = get_application()
 
+
+@app.middleware("http")
+async def protect_schema_and_docs(request: Request, call_next):
+    """Hardening (parche local): solo /ping es público. El esquema OpenAPI y
+    la documentación exigen x-api-key (los routers v1 ya llevan Depends)."""
+    if request.url.path in ("/openapi.json", "/docs", "/redoc"):
+        import hmac as _hmac
+
+        token = request.headers.get("x-api-key") or ""
+        expected = config.app.get("api_key", "")
+        if not expected or not _hmac.compare_digest(token, expected):
+            return JSONResponse(status_code=401, content={"error": "invalid token"})
+    return await call_next(request)
+
+
 # Configures the CORS middleware for the FastAPI app
