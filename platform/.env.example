# ============================================================================
# Phone Farm Platform — configuración (.env)
# Copia este archivo a .env y completa los valores.
# NUNCA committear .env (está en .gitignore). No loguear estas claves.
# ============================================================================

# --- Servidor Flask ---
FLASK_PORT=5000
# Orígenes CORS permitidos (solo loopback por seguridad). Coma-separados.
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:3000,http://localhost:3000

# --- API de IA (guiones) — Kimi (Moonshot) o OpenAI ---
# LLM_PROVIDER=kimi | openai
LLM_PROVIDER=kimi
KIMI_API_KEY=
OPENAI_API_KEY=

# --- MoneyPrinterTurbo ---
# URL de la API de MPT (en Docker: http://moneyprinter:8080; local: http://127.0.0.1:8080)
MPT_API_URL=http://127.0.0.1:8080
MPT_VIDEO_ASPECT=9:16
MPT_VOICE_NAME=es-ES-AlvaroNeural
# Sin MPT configurado, genera un vídeo placeholder con ffmpeg (solo para pruebas E2E)
DEMO_MODE=false

# --- Proxies DataImpulse ---
DATAIMPULSE_USER=
DATAIMPULSE_PASS=

# --- ADB ---
# En Docker: ADB_HOST=host.docker.internal (el server ADB corre en el host).
# Local (Mini PC): ADB_HOST=127.0.0.1
ADB_HOST=127.0.0.1
ADB_PORT=5037

# --- taktik-bot ---
TAKTIK_DIR=third_party/taktik-bot
# Duración de sesión de engagement (minutos) y perfiles máx. por sesión
BOT_SESSION_MINUTES=60

# --- Panda Grid (monitoreo visual) ---
PANDA_GRID_STATUS=Connected
